{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/holographme/identity-sigil-seal.schema.json",
  "title": "IdentitySigilSeal",
  "type": "object",
  "required": [
    "schema_version",
    "seal_id",
    "subject_id",
    "twin_id",
    "sigil",
    "portrait_policy",
    "signing_authorities",
    "consent_policy_ids",
    "transition_receipt_ids",
    "non_claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "seal_id": {"type": "string", "pattern": "^iss_[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$"},
    "twin_id": {"type": "string", "pattern": "^hdt_[a-zA-Z0-9_-]+$"},
    "display_context": {"type": "string"},
    "sigil": {
      "type": "object",
      "required": ["sigil_id", "sigil_type", "artifact_ref", "artifact_hash"],
      "additionalProperties": false,
      "properties": {
        "sigil_id": {"type": "string", "pattern": "^sigil_[a-zA-Z0-9_-]+$"},
        "sigil_type": {"type": "string", "enum": ["generated", "curated"]},
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "generation_method": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "portrait_policy": {
      "type": "object",
      "required": ["portrait_bound", "biometric_identity_claim", "public_default", "revocable", "selective_disclosure"],
      "additionalProperties": false,
      "properties": {
        "portrait_bound": {"type": "boolean"},
        "portrait_ref": {"type": "string"},
        "portrait_hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "biometric_identity_claim": {"type": "boolean"},
        "face_embedding_stored": {"type": "boolean"},
        "public_default": {"type": "boolean"},
        "revocable": {"type": "boolean"},
        "selective_disclosure": {"type": "boolean"},
        "context_bound": {"type": "boolean"}
      }
    },
    "signing_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["authority_id", "authority_type", "authority_ref", "scopes", "status"],
        "additionalProperties": false,
        "properties": {
          "authority_id": {"type": "string", "pattern": "^sa_[a-zA-Z0-9_-]+$"},
          "authority_type": {"type": "string", "enum": ["did", "wallet", "passkey", "hardware_key", "organization_key", "agent_key", "other"]},
          "authority_ref": {"type": "string", "minLength": 1},
          "scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "not_allowed_for": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["active", "retired", "revoked", "compromised"]},
          "valid_from": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "delegation_refs": {"type": "array", "items": {"type": "string", "pattern": "^dg_[a-zA-Z0-9_-]+$"}},
    "reputation_refs": {"type": "array", "items": {"type": "string"}},
    "consent_policy_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^cp_[a-zA-Z0-9_-]+$"}},
    "transition_receipt_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^tr_[a-zA-Z0-9_-]+$"}},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof_type": {"type": "string"},
        "created": {"type": "string", "format": "date-time"},
        "verification_method": {"type": "string"},
        "proof_purpose": {"type": "string"},
        "payload_hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
      }
    },
    "non_claims": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  }
}
