{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/holographme/export-bundle-manifest.schema.json",
  "title": "ExportBundleManifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "twin_id",
    "subject_id",
    "purpose",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "bundle_id": {"type": "string", "pattern": "^bundle_[a-zA-Z0-9_-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "twin_id": {"type": "string", "pattern": "^hdt_[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$"},
    "purpose": {"type": "string"},
    "custodian": {"type": "string"},
    "artifact_count": {"type": "integer", "minimum": 1},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "path", "digest", "media_type"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^artifact_[a-zA-Z0-9_-]+$"},
          "artifact_type": {
            "type": "string",
            "enum": [
              "human_digital_twin",
              "consent_policy",
              "mission",
              "projection",
              "projection_decision_log",
              "capability_claim_event_log",
              "transition_receipt",
              "security_policy",
              "readme",
              "other"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
