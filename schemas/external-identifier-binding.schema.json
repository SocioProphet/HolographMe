{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/holographme/external-identifier-binding.schema.json",
  "title": "ExternalIdentifierBinding",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "subject_id",
    "personhood_binding_ref",
    "external_identifier",
    "proofs",
    "allowed_uses",
    "disallowed_uses",
    "status",
    "portable",
    "retirable",
    "replacement_available",
    "risk",
    "non_claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "binding_id": {"type": "string", "pattern": "^eib_[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$"},
    "personhood_binding_ref": {"type": "string", "pattern": "^pbr_[a-zA-Z0-9_-]+$"},
    "external_identifier": {
      "type": "object",
      "required": ["kind", "value", "issuer_or_platform"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["apple_id", "google_account", "microsoft_account", "github_account", "email", "phone", "domain", "wallet", "government_credential", "employer_sso", "medical_portal", "bank_account", "device_account", "social_account", "other"]},
        "value": {"type": "string", "minLength": 1},
        "issuer_or_platform": {"type": "string", "minLength": 1},
        "redacted": {"type": "boolean"}
      }
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proof_type", "verified_at", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "proof_type": {"type": "string"},
          "verified_at": {"type": "string", "format": "date-time"},
          "evidence_ref": {"type": "string", "minLength": 1},
          "verifier_ref": {"type": "string"}
        }
      }
    },
    "allowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disallowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["active_primary", "active_secondary", "bridge_only", "deprecated", "retired", "revoked", "compromised", "disputed"]},
    "portable": {"type": "boolean"},
    "retirable": {"type": "boolean"},
    "replacement_available": {"type": "boolean"},
    "risk": {"type": "array", "items": {"type": "string"}},
    "transition_receipt_ids": {"type": "array", "items": {"type": "string", "pattern": "^tr_[a-zA-Z0-9_-]+$"}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "non_claims": {"type": "array", "minItems": 3, "items": {"type": "string"}}
  }
}
