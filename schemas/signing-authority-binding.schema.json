{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/holographme/signing-authority-binding.schema.json",
  "title": "SigningAuthorityBinding",
  "type": "object",
  "required": [
    "schema_version",
    "authority_id",
    "subject_id",
    "personhood_binding_ref",
    "authority_type",
    "authority_ref",
    "scopes",
    "not_allowed_for",
    "recovery_posture",
    "status",
    "proofs",
    "non_claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "authority_id": {"type": "string", "pattern": "^sa_[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$"},
    "personhood_binding_ref": {"type": "string", "pattern": "^pbr_[a-zA-Z0-9_-]+$"},
    "authority_type": {"type": "string", "enum": ["did", "wallet", "passkey", "hardware_key", "device_key", "domain_key", "organization_key", "guardian_quorum", "agent_key", "other"]},
    "authority_ref": {"type": "string", "minLength": 1},
    "scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "not_allowed_for": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recovery_posture": {"type": "string", "enum": ["recoverable_by_guardian_quorum", "recoverable_by_hardware_backup", "recoverable_by_institutional_process", "non_recoverable", "not_applicable"]},
    "status": {"type": "string", "enum": ["active_primary", "active_secondary", "bridge_only", "retired", "revoked", "compromised", "disputed"]},
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proof_type", "verified_at", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "proof_type": {"type": "string"},
          "verified_at": {"type": "string", "format": "date-time"},
          "evidence_ref": {"type": "string", "minLength": 1},
          "verifier_ref": {"type": "string"}
        }
      }
    },
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "transition_receipt_ids": {"type": "array", "items": {"type": "string", "pattern": "^tr_[a-zA-Z0-9_-]+$"}},
    "non_claims": {"type": "array", "minItems": 3, "items": {"type": "string"}}
  }
}
