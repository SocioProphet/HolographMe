{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/holographme/consent-policy.schema.json",
  "title": "ConsentPolicy",
  "type": "object",
  "required": ["schema_version", "policy_id", "subject_id", "allowed_recipients", "allowed_purposes", "allowed_fields", "expires_at", "revocation", "audit"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "policy_id": {"type": "string", "pattern": "^cp_[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$"},
    "allowed_recipients": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_purposes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_fields": {"type": "array", "items": {"type": "string"}},
    "projection_templates": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": "string", "format": "date-time"},
    "retention_rule": {"type": "string"},
    "revocation": {
      "type": "object",
      "required": ["revocable", "method"],
      "additionalProperties": false,
      "properties": {
        "revocable": {"type": "boolean"},
        "method": {"type": "string"},
        "contact": {"type": "string"}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents_allowed": {"type": "boolean"},
        "allowed_agent_actions": {"type": "array", "items": {"type": "string"}},
        "max_authority_band": {"type": "string", "enum": ["observe", "recommend", "represent", "negotiate", "commit"]}
      }
    },
    "audit": {
      "type": "object",
      "required": ["log_access", "emit_receipts"],
      "additionalProperties": false,
      "properties": {
        "log_access": {"type": "boolean"},
        "emit_receipts": {"type": "boolean"},
        "notify_subject": {"type": "boolean"}
      }
    }
  }
}
