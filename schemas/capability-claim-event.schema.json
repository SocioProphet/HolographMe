{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/holographme/capability-claim-event.schema.json",
  "title": "CapabilityClaimEventLog",
  "type": "object",
  "required": [
    "schema_version",
    "event_log_id",
    "twin_id",
    "subject_id",
    "claim_id",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "event_log_id": {"type": "string", "pattern": "^cce_[a-zA-Z0-9_-]+$"},
    "twin_id": {"type": "string", "pattern": "^hdt_[a-zA-Z0-9_-]+$"},
    "subject_id": {"type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$"},
    "claim_id": {"type": "string", "pattern": "^claim_[a-zA-Z0-9_-]+$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "event_type", "timestamp", "actor", "status_after"],
        "additionalProperties": false,
        "properties": {
          "event_id": {"type": "string", "pattern": "^ccev_[a-zA-Z0-9_-]+$"},
          "event_type": {
            "type": "string",
            "enum": [
              "claim_created",
              "evidence_attached",
              "review_recorded",
              "status_changed",
              "claim_expired",
              "claim_retired"
            ]
          },
          "timestamp": {"type": "string", "format": "date-time"},
          "actor": {
            "type": "object",
            "required": ["actor_id", "actor_type"],
            "additionalProperties": false,
            "properties": {
              "actor_id": {"type": "string"},
              "actor_type": {"type": "string", "enum": ["subject", "agent", "operator", "system"]}
            }
          },
          "status_before": {
            "type": "string",
            "enum": ["self_attested", "evidence_attached", "verified", "disputed", "expired", "retired"]
          },
          "status_after": {
            "type": "string",
            "enum": ["self_attested", "evidence_attached", "verified", "disputed", "expired", "retired"]
          },
          "confidence_before": {"type": "string", "enum": ["low", "medium", "high"]},
          "confidence_after": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$"}},
          "summary": {"type": "string"},
          "receipt_id": {"type": "string", "pattern": "^tr_[a-zA-Z0-9_-]+$"}
        }
      }
    }
  }
}
